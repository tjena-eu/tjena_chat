# Copy to lk-jwt.env (mode 600) and fill in. Never commit lk-jwt.env.

# From LiveKit Cloud: Project -> Settings -> Keys (wss URL, API key, secret).
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_KEY=APIxxxxxxxxxxxx
LIVEKIT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only tjena users may start calls (create LiveKit rooms). Users of other
# Matrix servers can still join a call a tjena user started.
LIVEKIT_FULL_ACCESS_HOMESERVERS=tjena.eu

LIVEKIT_JWT_BIND=:8080
LIVEKIT_LOG_LEVEL=info
